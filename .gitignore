_site/
.quarto/
_freeze/

# Quarto writes executed-figure output (matplotlib SVGs) to <doc>_files/.
# Ignore those next to the SOURCES, but NOT the copies under docs/ — docs/ is
# what GitHub Pages serves, so excluding them publishes decks with broken
# images wherever a {python} cell draws a plot.
*_files/
!docs/**/*_files/
.DS_Store
.Rproj.user/
.Rhistory
__pycache__/
*.pyc

/.quarto/

# Claude Code ephemeral
.claude/scheduled_tasks.lock
.claude/*.lock

# ---------------------------------------------------------------------------
# NOT FOR PUBLICATION.
# This repo is PUBLIC and serves the site at ts-robinson.com/me324, so anything
# committed below is readable by students -- including via the repo's history.
# ---------------------------------------------------------------------------

# Assessment. Never commit these.
exams/
quizzes/

# Midterm (take-home) — RELEASED 2026-08-12. Publish ONLY the student-facing
# files (brief, starter notebook, corpus + the render config); keep marker-side
# material private: autograde.py, README.md (reference numbers), the reference
# checkpoint, build scripts, the stray local hansard.txt, and the raw XML cache.
assessment/*
!assessment/midterm-brief.md
!assessment/midterm-starter.ipynb
!assessment/_metadata.yml
!assessment/data
assessment/data/*
!assessment/data/hansard-2026.txt

# Internal working documents.
*.docx
