_site/
.quarto/
_freeze/

# Quarto writes executed-figure output (matplotlib SVGs) to <doc>_files/.
# Ignore those next to the SOURCES, but NOT the copies under docs/ — docs/ is
# what GitHub Pages serves, so excluding them publishes decks with broken
# images wherever a {python} cell draws a plot.
*_files/
!docs/**/*_files/
.DS_Store
.Rproj.user/
.Rhistory
__pycache__/
*.pyc

/.quarto/

# Claude Code ephemeral
.claude/scheduled_tasks.lock
.claude/*.lock

# ---------------------------------------------------------------------------
# NOT FOR PUBLICATION.
